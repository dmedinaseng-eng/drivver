<%= link_to os_root_path, class: "flex items-center gap-2 overflow-hidden shrink-0" do %>
  <div data-sidebar-target="logoFull" class="flex items-center transition-opacity duration-300">
    <%= image_tag 'gradient-logo-h.svg', 
                  alt: 'Drivver OS', 
                  class: "h-15 w-auto object-contain dark:hidden" %>
    <%= image_tag 'wite-logo-h.svg', 
                  alt: 'Drivver OS', 
                  class: "h-15 w-auto object-contain hidden dark:block" %>
  </div>
  <div data-sidebar-target="logoIcon" class="hidden items-center transition-opacity duration-300">
    <%= image_tag 'gradient-symbol.svg', 
                  alt: 'Drivver OS', 
                  class: "h-13 w-auto object-contain dark:hidden" %>
    <%= image_tag 'wite-symbol.svg', 
                  alt: 'Drivver OS', 
                  class: "h-10 w-auto object-contain hidden dark:block" %>
  </div>
<% end %>
