<div class="hidden md:flex md:flex-col p-3 md:pb-6 w-full shrink-0 border-t border-gray-100 dark:border-gray-800/60 bg-transparent">
  <% if current_user %>
    <div class="flex flex-col gap-2 p-2.5">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-full bg-gray-100 dark:bg-gray-800 text-gray-800 dark:text-gray-200 flex items-center justify-center text-xs font-black shrink-0">
          <%= current_user.first_name.to_s[0].presence || current_user.email[0].upcase %>
        </div>
        <div data-sidebar-target="itemText" class="flex flex-col min-w-0 transition-opacity duration-300">
          <span class="text-xs font-extrabold text-[#0E1925] dark:text-white truncate">
            <%= current_user.full_name.presence || current_user.email.split('@').first %>
          </span>
          <span class="text-[10px] text-gray-500 font-bold truncate capitalize">
            <%= current_user.global_role&.humanize %>
          </span>
        </div>
      </div>
      <%= button_to destroy_user_session_path, method: :delete, class: "group flex items-center gap-3 mt-1 text-gray-500 hover:text-red-600 dark:text-gray-400 dark:hover:text-red-400 transition-colors cursor-pointer w-full text-left" do %>
        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
        </svg>
        <span data-sidebar-target="itemText" class="text-xs font-bold transition-opacity duration-300">
          Cerrar sesión
        </span>
      <% end %>
    </div>
  <% end %>
</div>