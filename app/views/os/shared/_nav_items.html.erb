<div class="flex flex-row w-full justify-around md:flex-col md:justify-start md:mt-4 md:space-y-1.5 md:px-3 flex-grow overflow-y-auto">
  <%= link_to os_root_path, class: "group flex flex-col md:flex-row items-center p-2.5 rounded-xl transition-all duration-200 #{current_page?(os_root_path) ? 'bg-blue-50 text-[#1C5686] dark:bg-[#1C5686] dark:text-white font-bold shadow-xs' : 'text-gray-500 hover:bg-gray-100 hover:text-[#0E1925] dark:text-gray-400 dark:hover:bg-[#142436] dark:hover:text-white font-medium'}" do %>
    <svg class="w-6 h-6 md:w-5 md:h-5 md:mr-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
    <span data-sidebar-target="itemText" class="text-[10px] md:text-xs tracking-tight truncate transition-opacity duration-300">Inicio</span>
  <% end %>
  
  <% if defined?(Deal)  %>
    <%= link_to "#", class: "group flex flex-col md:flex-row items-center p-2.5 rounded-xl transition-all duration-200 text-gray-500 hover:bg-gray-100 hover:text-[#0E1925] dark:text-gray-400 dark:hover:bg-[#142436] dark:hover:text-white font-medium" do %>
      <svg class="w-6 h-6 md:w-5 md:h-5 md:mr-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
      <span data-sidebar-target="itemText" class="text-[10px] md:text-xs tracking-tight truncate transition-opacity duration-300">Negocios</span>
    <% end %>
  <% end %>

  <% if operating_as_super_admin? %>
    <%= link_to "#", class: "hidden md:flex flex-col md:flex-row items-center p-2.5 rounded-xl transition-all duration-200 text-gray-500 hover:bg-gray-100 hover:text-[#0E1925] dark:text-gray-400 dark:hover:bg-[#142436] dark:hover:text-white font-medium" do %>
      <svg class="w-5 h-5 mr-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
      <span data-sidebar-target="itemText" class="text-xs tracking-tight truncate transition-opacity duration-300">Usuarios</span>
    <% end %>
  <% end %>

  <%= link_to "#", class: "hidden md:flex flex-col md:flex-row items-center p-2.5 rounded-xl transition-all duration-200 text-gray-500 hover:bg-gray-100 hover:text-[#0E1925] dark:text-gray-400 dark:hover:bg-[#142436] dark:hover:text-white font-medium" do %>
    <svg class="w-5 h-5 mr-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
    <span data-sidebar-target="itemText" class="text-xs tracking-tight truncate transition-opacity duration-300">Configuración</span>
  <% end %>

  <% if operating_as_super_admin? || defined?(Document) %>
    <button type="button" data-action="click->dropdown#toggle" class="md:hidden flex flex-col items-center p-2.5 text-gray-500 dark:text-gray-400 hover:text-[#0E1925] dark:hover:text-white transition-all cursor-pointer">
      <svg class="w-6 h-6 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path data-dropdown-target="openIcon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        <path data-dropdown-target="closeIcon" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
      <span class="text-[10px] tracking-tight">Más</span>
    </button>
  <% end %>
</div>