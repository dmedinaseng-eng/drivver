<div class="flex flex-row w-full justify-around md:flex-col md:justify-start md:mt-4 md:space-y-1.5 md:px-3 flex-grow overflow-y-auto">
  
  <% nav_menu = os_navigation_items %>

  <!-- Módulos Principales -->
  <% nav_menu[:main].each do |item| %>
    <%= link_to item[:path], class: "group flex flex-col md:flex-row items-center p-2.5 rounded-xl transition-all duration-200 #{current_page?(item[:path]) ? 'bg-blue-50 text-[#1C5686] dark:bg-[#1C5686] dark:text-white font-bold shadow-xs' : 'text-gray-500 hover:bg-gray-100 hover:text-[#0E1925] dark:text-gray-400 dark:hover:bg-[#142436] dark:hover:text-white font-medium'}" do %>
      <svg class="w-6 h-6 md:w-5 md:h-5 md:mr-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <%= raw item[:icon] %>
      </svg>
      <span data-sidebar-target="itemText" class="text-[10px] md:text-xs tracking-tight truncate"><%= item[:title] %></span>
    <% end %>
  <% end %>

  <!-- Separador Desktop -->
  <% if nav_menu[:system].any? %>
    <div class="border-t border-gray-100 dark:border-gray-800 my-2 mx-3 hidden md:block"></div>
  <% end %>

  <!-- Módulos de Sistema -->
  <% nav_menu[:system].each do |item| %>
    <% if item[:is_danger] %>
      <%= link_to item[:path], class: "hidden md:flex flex-col md:flex-row items-center p-2.5 rounded-xl transition-all duration-200 text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20 font-bold" do %>
        <svg class="w-5 h-5 mr-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><%= raw item[:icon] %></svg>
        <span data-sidebar-target="itemText" class="text-xs tracking-tight truncate"><%= item[:title] %></span>
      <% end %>
    <% else %>
      <%= link_to item[:path], class: "hidden md:flex flex-col md:flex-row items-center p-2.5 rounded-xl transition-all duration-200 text-gray-500 hover:bg-gray-100 hover:text-[#0E1925] dark:text-gray-400 dark:hover:bg-[#142436] dark:hover:text-white font-medium mt-auto" do %>
        <svg class="w-5 h-5 mr-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><%= raw item[:icon] %></svg>
        <span data-sidebar-target="itemText" class="text-xs tracking-tight truncate"><%= item[:title] %></span>
      <% end %>
    <% end %>
  <% end %>

</div>