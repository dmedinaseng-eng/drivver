<div class="bg-white dark:bg-[#0A0A0A] border border-gray-200 dark:border-gray-800 rounded-3xl p-6 shadow-sm" data-controller="passkey">
  <h2 class="text-lg font-bold text-[#0E1925] dark:text-white mb-2">Acceso Biométrico</h2>
  <p class="text-xs text-gray-500 dark:text-gray-400 mb-5 leading-relaxed">Inicia sesión sin contraseña usando FaceID o Huella.</p>
  <div data-passkey-target="error" class="hidden mb-4 p-3 bg-red-50 text-red-600 rounded-xl text-xs font-semibold border border-red-100"></div>
  <% if @passkeys.any? %>
    <ul class="space-y-3 mb-5">
      <% @passkeys.each do |passkey| %>
        <li class="flex items-center justify-between p-3 bg-gray-50 dark:bg-[#142436] rounded-xl border border-gray-100 dark:border-gray-800">
          <div class="flex items-center gap-3">
            <span class="text-xl">🔐</span>
            <div class="flex flex-col">
              <span class="text-xs font-bold text-gray-700 dark:text-gray-300">Dispositivo Autorizado</span>
              <span class="text-[10px] text-gray-400 font-medium"><%= l_datetime(passkey.created_at, format: :date_only) %></span>
            </div>
          </div>
          <%= button_to "Revocar", users_passkey_path(passkey), method: :delete, class: "text-[10px] font-bold text-red-500 hover:text-red-700 px-2 py-1 bg-red-50 dark:bg-red-900/20 rounded-md cursor-pointer", form: { data: { turbo_confirm: '¿Seguro?' } } %>
        </li>
      <% end %>
    </ul>
  <% end %>
  <button type="button" data-action="click->passkey#register" class="w-full py-3 bg-sky-50 dark:bg-[#142436] text-[#1C5686] dark:text-sky-400 border border-sky-100 dark:border-sky-900 rounded-xl font-bold text-xs flex items-center justify-center gap-2 hover:bg-sky-100 dark:hover:bg-[#1C5686]/30 transition-colors cursor-pointer shadow-sm">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A13.916 13.916 0 008 11a4 4 0 118 0c0 1.017-.07 2.019-.203 3m-2.118 6.844A21.88 21.88 0 0015.171 17m3.839 1.132c.645-2.266.99-4.659.99-7.132A8 8 0 004 11c0 2.473.345 4.866.99 7.132M13 11a1 1 0 11-2 0 1 1 0 012 0z"/></svg>
    Registrar nuevo dispositivo
  </button>
</div>