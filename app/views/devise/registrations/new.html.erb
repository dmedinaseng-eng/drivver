<div class="min-h-screen flex flex-col justify-center items-center px-4 py-12 bg-[#0E1925]">
  <div class="w-full max-w-lg bg-white p-8 rounded-3xl shadow-2xl border border-gray-100 text-gray-900">
    <div class="text-center mb-8">
      <div class="flex justify-center items-center gap-2 mb-3">
        <%= image_tag "blue-logo-horizontal.webp", alt: "Drivver OS", class: "h-15 object-contain" %>
      </div>
      <h2 class="text-2xl font-extrabold text-[#0E1925] tracking-tight">Crear Cuenta Drivver</h2>
      <p class="text-xs text-gray-500 mt-1 font-medium">Únete a la plataforma de gestión vehicular</p>
    </div>

    <%= render "devise/shared/google_auth", context: "signup", fallback_label: t("auth.google.sign_up") %>

    <div class="relative flex py-2 items-center mb-6">
      <div class="flex-grow border-t border-gray-200"></div>
      <span class="flex-shrink mx-4 text-gray-400 text-[10px] font-bold uppercase tracking-wider">O REGÍSTRATE CON CORREO</span>
      <div class="flex-grow border-t border-gray-200"></div>
    </div>
    
    <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
    <%= f.error_notification %>
      <div class="space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <%= f.input :first_name,
                      required: true,
                      label: "Nombre",
                      placeholder: "Carlos",
                      label_html: { class: "block text-xs font-bold text-gray-700 mb-1" },
                      input_html: { class: "w-full px-3 py-2.5 bg-gray-50 border border-gray-300 rounded-xl text-sm text-gray-900 focus:bg-white focus:border-sky-600 focus:ring-1 focus:ring-sky-600 transition-all placeholder-gray-400" } %>

          <%= f.input :last_name,
                      required: true,
                      label: "Apellido",
                      placeholder: "Pérez",
                      label_html: { class: "block text-xs font-bold text-gray-700 mb-1" },
                      input_html: { class: "w-full px-3 py-2.5 bg-gray-50 border border-gray-300 rounded-xl text-sm text-gray-900 focus:bg-white focus:border-sky-600 focus:ring-1 focus:ring-sky-600 transition-all placeholder-gray-400" } %>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <%= f.input :id_type,
                      collection: [ [ "Cédula de Ciudadanía", "CC" ], [ "Cédula de Extranjería", "CE" ], [ "NIT", "NIT" ], [ "Pasaporte", "PP" ] ],
                      label: "Tipo ID",
                      prompt: "Seleccionar",
                      required: true,
                      label_html: { class: "block text-xs font-bold text-gray-700 mb-1" },
                      input_html: { class: "w-full px-3 py-2.5 bg-gray-50 border border-gray-300 rounded-xl text-sm text-gray-900 focus:bg-white focus:border-sky-600 focus:ring-1 focus:ring-sky-600 transition-all cursor-pointer" } %>

          <div class="sm:col-span-2">
            <%= f.input :id_number,
                        required: true,
                        label: "Número de Documento",
                        placeholder: "1020304050",
                        label_html: { class: "block text-xs font-bold text-gray-700 mb-1" },
                        input_html: { class: "w-full px-3 py-2.5 bg-gray-50 border border-gray-300 rounded-xl text-sm text-gray-900 focus:bg-white focus:border-sky-600 focus:ring-1 focus:ring-sky-600 transition-all placeholder-gray-400" } %>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <%= f.input :phone_country_code,
                      as: :country,
                      priority: %w[CO MX US ES AR PE CL EC],
                      selected: "CO",
                      label: "País",
                      label_html: { class: "block text-xs font-bold text-gray-700 mb-1" },
                      input_html: { class: "w-full px-3 py-2.5 bg-gray-50 border border-gray-300 rounded-xl text-sm text-gray-900 focus:bg-white focus:border-sky-600 focus:ring-1 focus:ring-sky-600 transition-all cursor-pointer" } %>

          <div class="sm:col-span-2">
            <%= f.input :phone_number,
                        required: true,
                        label: "Teléfono Móvil",
                        placeholder: "3001234567",
                        label_html: { class: "block text-xs font-bold text-gray-700 mb-1" },
                        input_html: { class: "w-full px-3 py-2.5 bg-gray-50 border border-gray-300 rounded-xl text-sm text-gray-900 focus:bg-white focus:border-sky-600 focus:ring-1 focus:ring-sky-600 transition-all placeholder-gray-400" } %>
          </div>
        </div>

        <%= f.input :city,
                    required: true,
                    label: "Ciudad",
                    placeholder: "Bogotá",
                    label_html: { class: "block text-xs font-bold text-gray-700 mb-1" },
                    input_html: { class: "w-full px-3 py-2.5 bg-gray-50 border border-gray-300 rounded-xl text-sm text-gray-900 focus:bg-white focus:border-sky-600 focus:ring-1 focus:ring-sky-600 transition-all placeholder-gray-400" } %>

        <%= f.input :email,
                    required: true,
                    label: "Correo Electrónico",
                    placeholder: "ejemplo@drivver.com",
                    label_html: { class: "block text-xs font-bold text-gray-700 mb-1" },
                    input_html: { class: "w-full px-3 py-2.5 bg-gray-50 border border-gray-300 rounded-xl text-sm text-gray-900 focus:bg-white focus:border-sky-600 focus:ring-1 focus:ring-sky-600 transition-all placeholder-gray-400" } %>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <%= f.input :password,
                      required: true,
                      label: "Contraseña",
                      hint: "Mínimo 6 caracteres",
                      placeholder: "••••••••",
                      label_html: { class: "block text-xs font-bold text-gray-700 mb-1" },
                      hint_html: { class: "text-[10px] text-gray-400 mt-1" },
                      input_html: { class: "w-full px-3 py-2.5 bg-gray-50 border border-gray-300 rounded-xl text-sm text-gray-900 focus:bg-white focus:border-sky-600 focus:ring-1 focus:ring-sky-600 transition-all placeholder-gray-400" } %>

          <%= f.input :password_confirmation,
                      required: true,
                      label: "Confirmar Contraseña",
                      placeholder: "••••••••",
                      label_html: { class: "block text-xs font-bold text-gray-700 mb-1" },
                      input_html: { class: "w-full px-3 py-2.5 bg-gray-50 border border-gray-300 rounded-xl text-sm text-gray-900 focus:bg-white focus:border-sky-600 focus:ring-1 focus:ring-sky-600 transition-all placeholder-gray-400" } %>
        </div>
      </div>

      <div class="mt-8">
        <%= f.button :submit, "CREAR MI CUENTA DRIVVER", class: "w-full py-3 px-4 bg-[#1B5282] hover:bg-[#154168] text-white font-extrabold rounded-xl text-xs tracking-wider transition-colors shadow-md cursor-pointer uppercase" %>
      </div>
    <% end %>

    <div class="mt-6 text-center text-xs text-gray-500 pt-4 border-t border-gray-100">
      <p>
        ¿Ya tienes una cuenta?
        <%= link_to "Inicia sesión aquí", new_session_path(resource_name), class: "text-sky-600 font-bold hover:underline" %>
      </p>
    </div>
  </div>
</div>
