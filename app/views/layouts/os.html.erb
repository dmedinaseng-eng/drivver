<!DOCTYPE html>
<html lang="es" class="h-full <%= current_user&.dark? ? 'dark' : '' %>">
  <head>
    <title>Drivver OS - Sistema Operativo Vehicular</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= render "shared/fonts" %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-[#F8F9FA] dark:bg-[#050B14] antialiased flex h-screen overflow-hidden">
    <%= render 'os/shared/sidebar' %>
    <main id="main-content" class="flex-1 h-screen overflow-y-auto transition-all duration-300 md:ml-64">
      <div class="p-4 md:p-8">
        <%= render 'shared/flash' %>
        <%= yield %>
      </div>
    </main>
    <%= render 'os/shared/mobile_menu' %>
  </body>
</html>