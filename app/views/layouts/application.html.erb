<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="antialiased min-h-full">
  <head>
    <title><%= t("layouts.application.title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <%= csrf_meta_tags %>
    <%= render "shared/fonts" %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-full overflow-x-hidden bg-white text-[#0E1925] dark:bg-black dark:text-gray-100 transition-colors duration-300 selection:bg-[#1C5686] selection:text-white">
    <div id="flash-container" class="fixed top-4 right-4 z-[60] flex flex-col gap-2 pointer-events-none">
      <%= render "shared/flash" %>
    </div>
    <%= render "shared/navbar" %>
    <main id="public-main-content" class="min-h-screen pt-10 bg-[#0E1925]">
      <%= yield %>
    </main>
    <%= render "shared/footer" %>
  </body>
</html>
