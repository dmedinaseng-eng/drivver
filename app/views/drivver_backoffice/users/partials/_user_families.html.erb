<div class="bg-white dark:bg-[#142436] border border-gray-100 dark:border-gray-800 shadow-sm rounded-2xl p-6">
  <div class="flex items-center gap-2 mb-4">
    <span class="text-xl">👨‍👩‍👧‍👦</span>
    <h3 class="text-sm font-black text-[#0E1925] dark:text-white uppercase tracking-wider">Núcleo Familiar</h3>
  </div>
  
  <% if user.families.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <% user.families.each do |family| %>
        <div class="bg-gray-50 dark:bg-[#0E1925] rounded-xl p-4 border border-gray-100 dark:border-gray-800/50">
          <p class="text-xs font-black text-[#0E1925] dark:text-white mb-3 border-b border-gray-200 dark:border-gray-800 pb-2">
            Familia: <%= family.try(:name) || "##{family.id}" %>
          </p>
          <div class="flex flex-col gap-2">
            <% family.users.each do |member| %>
              <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-gray-600 dark:text-gray-300 truncate pr-2"><%= member.try(:full_name) || member.email %></span>
                <% if member.id == user.id %>
                  <span class="text-[9px] font-bold bg-blue-100 text-blue-600 dark:bg-blue-900/30 dark:text-blue-400 px-2 py-0.5 rounded shrink-0">Este usuario</span>
                <% else %>
                  <%= link_to "Ver Perfil", drivver_backoffice_user_path(member), class: "text-[10px] font-bold text-[#EF4444] hover:underline shrink-0" %>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="bg-gray-50 dark:bg-[#0E1925] rounded-xl p-4 text-center border border-gray-100 dark:border-gray-800/50">
      <p class="text-xs font-bold text-gray-400 italic">No pertenece a ninguna familia registrada.</p>
    </div>
  <% end %>
</div>