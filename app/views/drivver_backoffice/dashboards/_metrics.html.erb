<!-- Tarjetas de Métricas Globales (6 en 1 Fila) -->
<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 mb-8">
  <div class="bg-white dark:bg-[#142436] rounded-2xl p-4 border border-gray-100 dark:border-gray-800 shadow-sm relative overflow-hidden flex flex-col justify-between">
    <div class="absolute top-0 right-0 w-12 h-12 bg-blue-50 dark:bg-blue-900/20 rounded-bl-full -mr-6 -mt-6"></div>
    <div>
      <div class="flex items-center gap-3 mb-3 relative z-10">
        <div class="w-8 h-8 rounded-full bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center text-blue-600 dark:text-blue-400 shrink-0">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
        </div>
        <h3 class="text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider truncate">Usuarios</h3>
      </div>
      <p class="text-2xl font-black text-[#0E1925] dark:text-white"><%= number_with_delimiter(@total_users) %></p>
    </div>
    <div class="mt-3 pt-3 border-t border-gray-50 dark:border-gray-800/50 flex flex-col gap-1.5">
      <div class="flex items-center justify-between">
        <span class="text-[10px] font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wide">Activos</span>
        <span class="text-xs font-bold text-green-500 dark:text-green-400"><%= number_with_delimiter(@active_users) %></span>
      </div>
      <div class="flex items-center justify-between">
        <span class="text-[10px] font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wide">Suscritos</span>
        <span class="text-xs font-bold text-[#1C5686] dark:text-blue-400"><%= number_with_delimiter(@subscribed_users) %></span>
      </div>
    </div>
  </div>
  <div class="bg-white dark:bg-[#142436] rounded-2xl p-4 border border-gray-100 dark:border-gray-800 shadow-sm relative overflow-hidden flex flex-col justify-between">
    <div class="absolute top-0 right-0 w-12 h-12 bg-purple-50 dark:bg-purple-900/20 rounded-bl-full -mr-6 -mt-6"></div>
    <div>
      <div class="flex items-center gap-3 mb-3 relative z-10">
        <div class="w-8 h-8 rounded-full bg-purple-100 dark:bg-purple-900/30 flex items-center justify-center text-purple-600 dark:text-purple-400 shrink-0">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1v1H9V7zm5 0h1v1h-1V7zm-5 4h1v1H9v-1zm5 0h1v1h-1v-1zm-5 4h1v1H9v-1zm5 0h1v1h-1v-1z"/></svg>
        </div>
        <h3 class="text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider truncate">Empresas</h3>
      </div>
      <p class="text-2xl font-black text-[#0E1925] dark:text-white"><%= number_with_delimiter(@total_organizations) %></p>
    </div>
    <div class="mt-3 pt-3 border-t border-gray-50 dark:border-gray-800/50 flex flex-col gap-1.5">
      <div class="flex items-center justify-between">
        <span class="text-[10px] font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wide">Suscritas</span>
        <span class="text-xs font-bold text-purple-600 dark:text-purple-400"><%= number_with_delimiter(@active_orgs) %></span>
      </div>
    </div>
  </div>
  <div class="bg-white dark:bg-[#142436] rounded-2xl p-4 border border-gray-100 dark:border-gray-800 shadow-sm relative overflow-hidden flex flex-col justify-between">
    <div class="absolute top-0 right-0 w-12 h-12 bg-orange-50 dark:bg-orange-900/20 rounded-bl-full -mr-6 -mt-6"></div>
    <div>
      <div class="flex items-center gap-3 mb-3 relative z-10">
        <div class="w-8 h-8 rounded-full bg-orange-100 dark:bg-orange-900/30 flex items-center justify-center text-orange-600 dark:text-orange-400 shrink-0">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
        </div>
        <h3 class="text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider truncate">Vehículos</h3>
      </div>
      <p class="text-2xl font-black text-[#0E1925] dark:text-white"><%= number_with_delimiter(@total_vehicles) %></p>
    </div>
    <div class="mt-3 pt-3 border-t border-gray-50 dark:border-gray-800/50 flex flex-col gap-1.5">
      <div class="flex items-center justify-between">
        <span class="text-[10px] font-medium text-gray-400 dark:text-gray-500 uppercase tracking-wide">Total Red</span>
        <span class="text-xs font-bold text-gray-400 dark:text-gray-500">100%</span>
      </div>
    </div>
  </div>
  <div class="bg-white dark:bg-[#142436] rounded-2xl p-4 border border-gray-100 dark:border-gray-800 shadow-sm relative overflow-hidden flex flex-col justify-between">
    <div class="absolute top-0 right-0 w-12 h-12 bg-emerald-50 dark:bg-emerald-900/20 rounded-bl-full -mr-6 -mt-6"></div>
    <div>
      <div class="flex items-center gap-3 mb-3 relative z-10">
        <div class="w-8 h-8 rounded-full bg-emerald-100 dark:bg-emerald-900/30 flex items-center justify-center text-emerald-600 dark:text-emerald-400 shrink-0">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        </div>
        <h3 class="text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider truncate">Deals</h3>
      </div>
      <p class="text-2xl font-black text-[#0E1925] dark:text-white"><%= number_with_delimiter(@total_deals) %></p>
    </div>
    <div class="mt-3 pt-3 border-t border-gray-50 dark:border-gray-800/50 flex flex-col gap-1.5">
      <div class="flex items-center justify-between">
        <span class="text-[10px] font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wide">Ventas</span>
        <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400"><%= number_with_delimiter(@sales_deals) %></span>
      </div>
      <div class="flex items-center justify-between">
        <span class="text-[10px] font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wide">Compras</span>
        <span class="text-xs font-bold text-[#1C5686] dark:text-blue-400"><%= number_with_delimiter(@purchase_deals) %></span>
      </div>
    </div>
  </div>
  <div class="bg-white dark:bg-[#142436] rounded-2xl p-4 border border-gray-100 dark:border-gray-800 shadow-sm relative overflow-hidden flex flex-col justify-between">
    <div class="absolute top-0 right-0 w-12 h-12 bg-pink-50 dark:bg-pink-900/20 rounded-bl-full -mr-6 -mt-6"></div>
    <div>
      <div class="flex items-center gap-3 mb-3 relative z-10">
        <div class="w-8 h-8 rounded-full bg-pink-100 dark:bg-pink-900/30 flex items-center justify-center text-pink-600 dark:text-pink-400 shrink-0">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        </div>
        <h3 class="text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider truncate">Eventos</h3>
      </div>
      <p class="text-2xl font-black text-[#0E1925] dark:text-white"><%= number_with_delimiter(@total_events) %></p>
    </div>
    <div class="mt-3 pt-3 border-t border-gray-50 dark:border-gray-800/50 flex flex-col gap-1.5">
      <div class="flex items-center justify-between">
        <span class="text-[10px] font-medium text-gray-400 dark:text-gray-500 uppercase tracking-wide">Histórico</span>
        <span class="text-xs font-bold text-gray-400 dark:text-gray-500">100%</span>
      </div>
    </div>
  </div>
  <div class="bg-white dark:bg-[#142436] rounded-2xl p-4 border border-gray-100 dark:border-gray-800 shadow-sm relative overflow-hidden flex flex-col justify-between">
    <div class="absolute top-0 right-0 w-12 h-12 bg-teal-50 dark:bg-teal-900/20 rounded-bl-full -mr-6 -mt-6"></div>
    <div>
      <div class="flex items-center gap-3 mb-3 relative z-10">
        <div class="w-8 h-8 rounded-full bg-teal-100 dark:bg-teal-900/30 flex items-center justify-center text-teal-600 dark:text-teal-400 shrink-0">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
        </div>
        <h3 class="text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider truncate">Suscrip.</h3>
      </div>
      <p class="text-2xl font-black text-[#0E1925] dark:text-white"><%= number_with_delimiter(@total_subscriptions) %></p>
    </div>
    <div class="mt-3 pt-3 border-t border-gray-50 dark:border-gray-800/50 flex flex-col gap-1.5">
      <div class="flex items-center justify-between">
        <span class="text-[10px] font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wide">Activas</span>
        <span class="text-xs font-bold text-teal-600 dark:text-teal-400"><%= number_with_delimiter(@active_subscriptions) %></span>
      </div>
      <div class="flex items-center justify-between">
        <span class="text-[10px] font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wide">Inactivas</span>
        <span class="text-xs font-bold text-red-500 dark:text-red-400"><%= number_with_delimiter(@inactive_subscriptions) %></span>
      </div>
    </div>
  </div>
</div>