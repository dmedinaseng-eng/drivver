<nav class="bg-white dark:bg-[#0E1925] border-b border-gray-200 dark:border-[#142436] sticky top-0 z-50 relative">
  <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-16">
      
      <!-- Izquierda: Logo y Menú Principal -->
      <div class="flex h-full">
        <!-- Logo -->
        <div class="flex-shrink-0 flex items-center gap-3">
          <%= link_to drivver_backoffice_root_path, class: "flex items-center gap-3" do %>
            <%= image_tag 'gradient-symbol.svg', alt: 'Drivver', class: "h-8 w-auto dark:hidden" %>
            <%= image_tag 'wite-symbol.svg', alt: 'Drivver', class: "h-8 w-auto hidden dark:block" %>
            <span class="font-black text-xl text-[#0E1925] dark:text-white tracking-tight hidden lg:block">
              Admin
            </span>
          <% end %>
        </div>
        
        
          <!-- Enlaces Desktop -->
        <div class="hidden sm:ml-10 sm:flex sm:space-x-8 h-full">
          <!-- 1. Dashboard -->
          <%= link_to "Dashboard", drivver_backoffice_root_path, class: backoffice_nav_classes(:dashboard) %>

          <!-- 2. Directorio Dropdown -->
          <div data-controller="dropdown" class="relative flex items-center h-full">
            <button type="button" data-action="click->dropdown#toggle" class="<%= backoffice_nav_classes(:directorio) %>">
              Directorio
              <svg class="w-4 h-4 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </button>

            <!-- Menú Directorio -->
            <div data-dropdown-target="menu" class="hidden absolute left-0 top-[calc(100%-0.25rem)] w-56 bg-white dark:bg-[#142436] border border-gray-200 dark:border-gray-800 rounded-2xl shadow-xl p-2 z-50 flex flex-col gap-1">
              <%= link_to "Usuarios", drivver_backoffice_users_path, class: "w-full text-left px-3 py-2.5 rounded-xl text-sm font-medium text-[#0E1925] dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-[#0E1925] transition-colors" %>
              <%= link_to "Organizaciones", drivver_backoffice_organizations_path, class: "w-full text-left px-3 py-2.5 rounded-xl text-sm font-medium text-[#0E1925] dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-[#0E1925] transition-colors" %>
              <%= link_to "Vehículos", drivver_backoffice_vehicles_path, class: "w-full text-left px-3 py-2.5 rounded-xl text-sm font-medium text-[#0E1925] dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-[#0E1925] transition-colors" %>
              <%= link_to "Deals", drivver_backoffice_deals_path, class: "w-full text-left px-3 py-2.5 rounded-xl text-sm font-medium text-[#0E1925] dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-[#0E1925] transition-colors" %>
              <%= link_to "Eventos", drivver_backoffice_events_path, class: "w-full text-left px-3 py-2.5 rounded-xl text-sm font-medium text-[#0E1925] dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-[#0E1925] transition-colors" %>
            </div>
          </div>

          <!-- 3. Blog Dropdown -->
          <div data-controller="dropdown" class="relative flex items-center h-full">
            <button type="button" data-action="click->dropdown#toggle" class="<%= backoffice_nav_classes(:blog) %>">
              Blog
              <svg class="w-4 h-4 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </button>

            <!-- Menú Blog -->
            <div data-dropdown-target="menu" class="hidden absolute left-0 top-[calc(100%-0.25rem)] w-48 bg-white dark:bg-[#142436] border border-gray-200 dark:border-gray-800 rounded-2xl shadow-xl p-2 z-50 flex flex-col gap-1">
              <%= link_to "Index", drivver_backoffice_blog_posts_path, class: "w-full text-left px-3 py-2.5 rounded-xl text-sm font-medium text-[#0E1925] dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-[#0E1925] transition-colors" %>
              <%= link_to "Crear nuevo", new_drivver_backoffice_blog_post_path, class: "w-full text-left px-3 py-2.5 rounded-xl text-sm font-medium text-[#0E1925] dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-[#0E1925] transition-colors" %>
            </div>
          </div>
        </div>
      </div>

      <!-- Derecha: Configuración y Selector de Entornos -->
      <div class="flex items-center h-full gap-2 sm:gap-4">
        
        <!-- Botón Configuración (Settings) -->
        <%= link_to os_settings_path, class: "p-2 rounded-full text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-[#1C304A] hover:text-[#0E1925] dark:hover:text-white transition-colors focus:outline-none", title: "Configuración" do %>
          <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
        <% end %>

        <!-- Selector de Entornos -->
        <div data-controller="dropdown" class="relative">
          <button type="button" data-action="click->dropdown#toggle" class="flex items-center gap-2 px-3 py-2 rounded-xl bg-gray-50 dark:bg-[#142436] hover:bg-gray-100 dark:hover:bg-[#1C304A] transition-colors focus:outline-none border border-gray-200 dark:border-gray-700 shadow-sm">
            <div class="w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold text-white bg-[#EF4444] shadow-sm">
              🚨
            </div>
            <span class="text-sm font-bold text-[#0E1925] dark:text-white hidden md:block">Admin</span>
            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </button>

          <!-- Dropdown -->
          <div data-dropdown-target="menu" class="hidden absolute right-0 mt-3 w-64 bg-white dark:bg-[#142436] border border-gray-200 dark:border-gray-800 rounded-2xl shadow-2xl p-2 z-50 flex flex-col gap-1">
            <span class="block px-3 py-2 text-[10px] font-black uppercase text-gray-400">Cambiar Entorno</span>
            
            <% available_contexts_ui.each do |ctx| %>
              <%= link_to ctx[:url], data: { turbo: false }, class: "w-full text-left flex items-center gap-3 p-2.5 rounded-xl text-xs font-bold text-[#0E1925] dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-[#0E1925] transition-colors cursor-pointer #{ctx[:id] == 'drivver_backoffice' ? 'bg-gray-100 dark:bg-[#0E1925]' : ''}" do %>
                <div class="w-7 h-7 rounded-full flex items-center justify-center text-xs shrink-0 shadow-sm text-white" style="background-color: <%= ctx[:color] %>;">
                  <%= ctx[:emoji] %>
                </div>
                <span class="truncate flex-1"><%= ctx[:name] %></span>
                <% if ctx[:id] == 'drivver_backoffice' %>
                  <div class="w-2 h-2 rounded-full shrink-0 bg-[#EF4444]"></div>
                <% end %>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
      
    </div>
  </div>
</nav>