<div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white dark:bg-[#142436] p-6 rounded-2xl border border-gray-100 dark:border-gray-800 shadow-sm">
  <div>
    <!-- Renderizado dinámico de Breadcrumbs -->
    <% if local_assigns[:breadcrumbs].present? %>
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-2">
          <% breadcrumbs.each_with_index do |crumb, index| %>
            <li class="inline-flex items-center">
              <% if index > 0 %>
                <svg class="w-3.5 h-3.5 text-gray-400 mx-2" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
                  <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
                </svg>
              <% end %>
              
              <% if crumb[:url].present? %>
                <%= link_to crumb[:name], crumb[:url], class: "text-xs font-bold text-gray-400 hover:text-[#EF4444] dark:text-gray-500 dark:hover:text-[#EF4444] transition-colors" %>
              <% else %>
                <span class="text-xs font-bold text-[#0E1925] dark:text-gray-200"><%= crumb[:name] %></span>
              <% end %>
            </li>
          <% end %>
        </ol>
      </nav>
    <% end %>

    <h1 class="text-2xl font-black tracking-tight text-[#0E1925] dark:text-white">
      <%= title %>
    </h1>
    <div class="flex items-center gap-2 mt-2">
      <p class="text-sm text-[#EF4444] ">
        <span class="font-bold">Objetivo Global:</span> Para diciembre 2026 tener 20 negocios activos.
      </p>
    </div>
  </div>
  <div class="hidden md:block text-right">
    <p class="text-xs font-bold text-gray-400 uppercase tracking-widest">Drivver OS</p>
    <p class="text-sm text-gray-500 dark:text-gray-400">Entorno Administrativo</p>
  </div>
</div>