<section class="relative flex flex-col items-center min-h-[85vh] px-6 py-18 md:px-20 max-w-7xl mx-auto overflow-hidden min-h-screen md:-my-20">
  <video id="hero-bg-video" 
         muted 
         playsinline 
         autoplay
         preload="auto"
         class="absolute inset-0 w-full h-full object-cover object-center opacity-50 z-0 mix-blend-lighten pointer-events-none">
    <source src="<%= video_path('hero-bg.webm') %>" type="video/webm">
  </video>
  
  <div class="relative z-10 text-center my-auto">
    <h1 class="text-4xl sm:text-4xl md:text-6xl font-extrabold leading-tight tracking-tight mb-6 mt-6 text-white break-words">
      <%= landing_t(:hero_title) %>
    </h1>
    <p class="text-base sm:text-lg md:text-xl text-gray-300 mb-10 leading-relaxed max-w-xl mx-auto">
      <%= landing_t(:hero_subtitle) %>
    </p>
  </div>

  <div class="w-full max-w-xs relative z-10 mx-auto mt-auto pb-12">
    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center w-full">
      <%= link_to landing_t(:hero_cta), 
          @cta_url, 
          target: "_blank",
          rel: "noopener noreferrer",
          class: "flex justify-center items-center px-6 py-4 bg-[#1C5686] hover:bg-sky-400 text-white font-semibold rounded-lg sm:rounded-none transition-colors w-full sm:flex-1 text-center shadow-lg" %>
    </div>
  </div>
</section>