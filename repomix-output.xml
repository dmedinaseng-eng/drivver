  def super_admin?
    user&.super_admin? || user&.developer?
  end

  class Scope
    attr_reader :user, :scope

    def initialize(user, scope)
      @user = user
      @scope = scope
    end

    def resolve
      raise NotImplementedError, "You must define #resolve in #{self.class}"
    end
  end
end
</file>

<file path="app/policies/dashboard_policy.rb">
class DashboardPolicy < ApplicationPolicy
    def show?
      user.present? && user.active?
    end
  end
</file>

<file path="app/views/devise/registrations/new.html.erb">
<div class="min-h-screen flex flex-col justify-center items-center px-4 py-12 bg-[#0E1925]">
